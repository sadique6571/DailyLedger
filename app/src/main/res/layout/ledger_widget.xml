<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DAILY LEDGER" android:textColor="#CDFBFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Remaining balance" android:textColor="#C0FFEE" android:textSize="11sp" />
    <TextView android:id="@+id/widget_balance" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Balance hidden" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_dues" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="#E6FFFA" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/widget_pill_light" android:gravity="center" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="+ Expense" android:textColor="#004664" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_udhar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/widget_pill_ghost" android:gravity="center" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="+ Udhar" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
